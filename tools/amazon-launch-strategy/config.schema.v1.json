{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecomwizards.agency/schemas/amazon-launch-strategy.v1.json",
  "title": "Amazon Launch Strategy v1",
  "type": "object",
  "required": ["schema_version", "client", "baseline", "external_channels", "products", "ppc", "scenarios", "reviews", "sources", "owners"],
  "properties": {
    "schema_version": {"const": "amazon-launch-strategy.v1"},
    "client": {
      "type": "object",
      "required": ["name", "brand", "account", "marketplace", "currency", "launch_timing_label", "output_dir"],
      "properties": {
        "name": {"type": "string"},
        "brand": {"type": "string"},
        "account": {"type": "string"},
        "marketplace": {"type": "string"},
        "currency": {"type": "string"},
        "launch_date": {"type": ["string", "null"], "format": "date"},
        "launch_timing_label": {"type": "string"},
        "output_dir": {"type": "string"},
        "file_stem": {"type": "string"}
      }
    },
    "baseline": {"type": "object"},
    "external_channels": {"type": "object"},
    "commercial_targets": {"$ref": "#/$defs/commercialTargets"},
    "products": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/product"}},
    "ppc": {
      "type": "object",
      "required": ["phases"],
      "properties": {"phases": {"type": "array", "items": {"$ref": "#/$defs/phase"}}}
    },
    "scenarios": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/scenario"}},
    "reviews": {"type": "object"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "owners": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "product": {
      "type": "object",
      "required": ["id", "name", "phase", "list_price", "unit_economics", "inventory", "reviews"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "phase": {"enum": ["launch", "later"]},
        "list_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "launch_price": {"$ref": "#/$defs/nullableNumber"},
        "coupon_pct": {"type": "number", "minimum": 0, "maximum": 1},
        "unit_economics": {"type": "object"},
        "inventory": {"type": "object"},
        "reviews": {"type": "object"}
      }
    },
    "phase": {
      "type": "object",
      "required": ["id", "name", "start_week", "end_week"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "start_week": {"type": "integer", "minimum": 1, "maximum": 13},
        "end_week": {"type": "integer", "minimum": 1, "maximum": 13},
        "daily_budget_cap": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "label", "products"],
      "properties": {
        "id": {"enum": ["low", "base", "high"]},
        "label": {"type": "string"},
        "products": {"type": "object"}
      }
    },
    "campaignAllocation": {
      "type": "object",
      "required": ["high_intent_non_branded", "discovery", "competitor_keywords", "competitor_product_targeting", "branded_defense"],
      "properties": {
        "high_intent_non_branded": {"type": "number", "minimum": 0, "maximum": 1},
        "discovery": {"type": "number", "minimum": 0, "maximum": 1},
        "competitor_keywords": {"type": "number", "minimum": 0, "maximum": 1},
        "competitor_product_targeting": {"type": "number", "minimum": 0, "maximum": 1},
        "branded_defense": {"const": 0.05}
      },
      "additionalProperties": false
    },
    "monthlyPpcPlan": {
      "type": "object",
      "required": ["label", "planned_spend", "spend_ceiling", "campaign_allocation"],
      "properties": {
        "label": {"type": "string"},
        "planned_spend": {"type": "number", "minimum": 0},
        "spend_ceiling": {"type": "number", "minimum": 0},
        "planning_cpc": {"$ref": "#/$defs/nullableNumber"},
        "planning_cvr": {"$ref": "#/$defs/nullableNumber"},
        "campaign_allocation": {"$ref": "#/$defs/campaignAllocation"}
      },
      "additionalProperties": false
    },
    "commercialTargets": {
      "type": "object",
      "required": ["daily_revenue_milestones", "stock_safety_buffer_pct", "stock_rounding_increment", "product_mix_by_month", "ppc_plan"],
      "properties": {
        "daily_revenue_milestones": {
          "type": "object",
          "required": ["month_1_exit", "month_2_exit", "month_3_committed", "month_3_stretch"],
          "properties": {
            "month_1_exit": {"type": "number", "minimum": 0},
            "month_2_exit": {"type": "number", "minimum": 0},
            "month_3_committed": {"type": "number", "minimum": 0},
            "month_3_stretch": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "stock_safety_buffer_pct": {"type": "number", "minimum": 0},
        "stock_rounding_increment": {"type": "integer", "minimum": 1},
        "product_mix_by_month": {
          "type": "object",
          "required": ["month_1", "month_2", "month_3"],
          "properties": {
            "month_1": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
            "month_2": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
            "month_3": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}
          },
          "additionalProperties": false
        },
        "ppc_plan": {
          "type": "object",
          "required": ["month_1", "month_2", "month_3_committed", "month_3_stretch"],
          "properties": {
            "month_1": {"$ref": "#/$defs/monthlyPpcPlan"},
            "month_2": {"$ref": "#/$defs/monthlyPpcPlan"},
            "month_3_committed": {"$ref": "#/$defs/monthlyPpcPlan"},
            "month_3_stretch": {"$ref": "#/$defs/monthlyPpcPlan"}
          },
          "additionalProperties": false
        },
        "keywords": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
