{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge sweep card",
  "description": "Intermediate record between a source (Slack thread, lesson, run note, SOP) and a knowledge unit. Cards keep identifiers; units never do. Cards live under the gitignored _local/knowledge-sweep/cards/ tree.",
  "type": "object",
  "required": ["card_id", "source_kind", "topic", "kind", "title", "problem_as_asked", "generic_lesson", "resolution_status", "fix_source", "evidence_location", "confidence", "publishable", "policy_risk", "client_specific_to_strip"],
  "properties": {
    "card_id": {"type": "string", "pattern": "^CARD-[0-9]{4,}$"},
    "source_kind": {"type": "string", "enum": ["slack-thread", "lesson", "run-note", "playbook", "mag-sop", "help-page", "answer-draft", "operator"]},
    "topic": {"type": "string", "enum": ["compliance", "logistics", "catalog", "support-cases", "ads", "account-health", "seo", "brand-registry", "reporting"]},
    "kind": {"type": "string", "enum": ["diagnosis", "procedure", "rule", "reference", "decision-aid"]},
    "title": {"type": "string", "description": "Symptom first, no brand, no client, no person."},
    "skills": {"type": "array", "items": {"type": "string"}},
    "surface": {"type": "string"},
    "surface_verified": {"type": "boolean"},
    "marketplaces": {"type": "array", "items": {"type": "string"}},
    "marketplace_inferred": {"type": "boolean"},
    "symptom_keywords": {"type": "array", "items": {"type": "string"}},
    "error_text": {"type": "array", "items": {"type": "string"}, "description": "Verbatim Amazon notices or codes, for example FBA_INB_0008."},
    "problem_as_asked": {"type": "string"},
    "root_cause": {"type": "string"},
    "resolution_steps": {"type": "array", "items": {"type": "string"}},
    "verify": {"type": "string"},
    "generic_lesson": {"type": "string", "description": "What any seller in that situation should do; this becomes the Answer section."},
    "amazon_rule_or_page": {"type": "string"},
    "first_party_source_paths": {"type": "array", "items": {"type": "string"}, "description": "Repo-relative paths under the capture libraries that back the rule."},
    "related_sop_paths": {"type": "array", "items": {"type": "string"}},
    "resolution_status": {"type": "string", "enum": ["resolved", "partial", "diagnosis-only", "unknown"]},
    "fix_source": {"type": "string", "enum": ["agency", "client", "amazon-support", "first-party-doc", "unknown"]},
    "evidence_location": {"type": "string", "enum": ["slack", "screenshot", "call", "email", "case", "video", "run-note", "none"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "coverage_verdict": {"type": "string", "enum": ["none", "partial", "full", "unchecked"]},
    "coverage_paths": {"type": "array", "items": {"type": "string"}},
    "net_new": {"type": "string"},
    "contradicts_paths": {"type": "array", "items": {"type": "string"}},
    "publishable": {"type": "boolean", "description": "False when the lesson cannot be generalised without identifying the client, or depends on a private arrangement."},
    "policy_risk": {"type": "boolean", "description": "True when the practice may violate Amazon policy; the agency lead decides."},
    "policy_risk_reason": {"type": "string"},
    "participants_external": {"type": "boolean", "description": "True when client staff, suppliers or Amazon staff wrote in the thread."},
    "language": {"type": "string"},
    "client_specific_to_strip": {"type": "array", "items": {"type": "string"}},
    "who_asked_role": {"type": "string"},
    "who_answered": {"type": "string", "description": "Slack user ID or role; never a client's name in the unit."},
    "who_executed": {"type": "string"},
    "date_first_seen": {"type": "string", "description": "YYYY-MM-DD"},
    "date_resolved": {"type": "string"},
    "client_slug": {"type": "string"},
    "channel_id": {"type": "string"},
    "channel_name": {"type": "string"},
    "parent_ts": {"type": "string"},
    "related_ts": {"type": "array", "items": {"type": "string"}},
    "permalink": {"type": "string"},
    "identifiers": {"type": "array", "items": {"type": "string"}, "description": "ASINs, case, shipment or order IDs seen in the source; ledger only."},
    "notes": {"type": "string"}
  }
}
