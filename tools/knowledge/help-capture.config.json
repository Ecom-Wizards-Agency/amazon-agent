{
  "schema_version": 1,
  "staging_root": "_local/knowledge-sweep/help-refresh",
  "defaults": {
    "min_body_words": 120,
    "account_placeholder": "Example Brand",
    "poll_timeout_ms": 20000,
    "poll_interval_ms": 1000,
    "thin_stable_polls": 3,
    "shell_line_pattern": "^[ \\t]*Loading[ \\t]*$",
    "login_url_pattern": "/ap/",
    "allowed_email_domains": [
      "amazon.com", "amazon.ca", "amazon.com.mx", "amazon.com.br", "amazon.co.uk", "amazon.de",
      "amazon.fr", "amazon.it", "amazon.es", "amazon.nl", "amazon.se", "amazon.pl", "amazon.com.be",
      "amazon.ie", "amazon.com.tr", "amazon.ae", "amazon.sa", "amazon.eg", "amazon.co.za", "amazon.in",
      "amazon.co.jp", "amazon.com.au", "amazon.sg"
    ],
    "keep_mons_sel_params": ["mons_sel_locale"],
    "public_marketplace_ids": [
      "ATVPDKIKX0DER",
      "A1PA6795UKMFR9",
      "A1F83G8C2ARO7P",
      "A13V1IB3VIYZZH",
      "APJ6JRA9NG5V4",
      "A1RKKUPIHCS9HS",
      "A1805IZSGTT6HH",
      "A1805IZSGTT6HS",
      "A2NODRKZP88ZB9",
      "A1C3SOZRARQ6R3",
      "A39IBJ37TRP1C6",
      "A1VC38T7YXB528",
      "A2EUQ1WTGCTBG2",
      "A1AM78C64UM0Y8",
      "A21TJRUUN4KGV",
      "A2Q3Y263D00KWC",
      "A33AVAJ2PDY3EV",
      "A17E79C6D8DWNP",
      "A2VIGQ35RCS4UG",
      "A19VAU5U5O7RUS",
      "AMEN7PMS3EDWL",
      "ARBP9OOSHTCHU",
      "A28R8C7NBKEWEA",
      "AE08WJ6YKNBMC"
    ]
  },
  "libraries": {
    "seller-help": {
      "label": "Amazon Seller Help",
      "root": "Amazon Seller Help",
      "index": "_index/seller-help-index.json",
      "missing_list": "_index/seller-help-missing.json",
      "articles_dir": "articles",
      "pages_path": "pages",
      "new_entries_list": "pages",
      "fields": {
        "id": "id",
        "title": "title",
        "url": "url",
        "file": "file",
        "bytes": "bytes",
        "downloaded_at": "downloaded_at"
      },
      "id_from_url": "/help/hub/reference/(?:external/)?([A-Z0-9]+)",
      "origin": "https://sellercentral.amazon.com",
      "navigate_query": { "mons_sel_locale": "en_US" },
      "missing_on_redirect": true,
      "region_task": {
        "kind": "seller-central-region",
        "marketplace": "us",
        "origin": "https://sellercentral.amazon.com"
      },
      "frontmatter_keys": ["title", "source_url", "downloaded_at", "source"],
      "frontmatter_defaults": { "source": "Amazon Seller Central Help" },
      "new_file_pattern": "{seq}-{slug}-{id}.md"
    },
    "ads-support": {
      "label": "Advertising Help After Login",
      "root": "Advertising Help After Login",
      "index": "_index/advertising-help-index.json",
      "missing_list": "_index/advertising-help-missing.json",
      "articles_dir": "articles",
      "pages_path": "pages",
      "extra_index_lists": ["captured_pages"],
      "new_entries_list": "captured_pages",
      "fields": {
        "id": null,
        "title": "title",
        "url": "url",
        "file": "file",
        "bytes": "bytes",
        "downloaded_at": "downloaded_at"
      },
      "id_from_url": "/help/([A-Z0-9]+)",
      "origin": "https://advertising.amazon.com",
      "navigate_query": {},
      "missing_on_redirect": true,
      "region_task": { "kind": "plain", "workflow": "amazon-help-capture" },
      "frontmatter_keys": ["title", "source_url", "library", "section", "downloaded_at", "status"],
      "frontmatter_defaults": {
        "library": "Amazon Ads Support Center",
        "section": "linked-expansion",
        "status": "captured"
      },
      "linked_list": "_index/linked-expansion/remaining-linked-urls-2026-05-13.txt",
      "new_file_pattern": "{seq}-{slug}-{id}.md"
    },
    "ads-docs": {
      "label": "Amazon Ads Help",
      "root": "Amazon Ads Help",
      "index": "_index/amazon-ads-help-index.json",
      "missing_list": "_index/amazon-ads-help-missing.json",
      "articles_dir": "articles",
      "pages_path": "sections",
      "grouped_by_section": true,
      "new_entries_list": null,
      "fields": {
        "id": null,
        "title": "title",
        "url": "url",
        "file": null,
        "bytes": "bytes",
        "downloaded_at": "downloaded_at"
      },
      "id_from_url": null,
      "origin": "https://advertising.amazon.com",
      "navigate_query": {},
      "missing_on_redirect": false,
      "region_task": { "kind": "plain", "workflow": "amazon-help-capture" },
      "frontmatter_keys": ["title", "source_url", "library", "section", "downloaded_at", "status"],
      "frontmatter_defaults": {
        "library": "Amazon Ads Advanced Tools Center",
        "status": "captured"
      },
      "new_file_pattern": "{section}/{seq}-{slug}.md"
    }
  }
}
